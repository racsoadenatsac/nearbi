#!/usr/bin/env bash
# Pull every splitter (+ forwarder on mainnet) event, rebuild ledger.jsonl (hash-chained), reconcile against the contract and
# render out/ledger/. Exits non-zero on any reconciliation mismatch; nothing is written in that case.
#   bin/build-ledger [--network mainnet|testnet] [--allow-seed-only] [--retries N]   (writes out/<network>/ledger/)
set -euo pipefail
cd "$(dirname "$0")/.."
exec bin/py src/build_ledger.py "$@"
