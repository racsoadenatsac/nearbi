#!/usr/bin/env python3
"""agent-tick: one scheduler-friendly pass of the whole live shop, then exit.

  bin/agent-tick              1. bin/forwarder-runner --once   (settled 1Click payments -> forward() -> splitter)
                              2. bin/agent-orders              (paid + forwarded orders -> report -> nearbi.ai -> onchain)
  bin/agent-tick --dry-run    the same two steps with --dry-run: every read and check, no claim, no DynamoDB/S3/API
                              write, no signing broadcast, no paid inference
Options: --max-orders N, --max-usd X (passed to agent-orders), --config F (both steps), --skip-forwarder.

Step 2 always runs after step 1, except when step 1 says SSO expired (3) or refused by config.yaml (5): then
the tick stops there. Orders are only fulfilled once forwardedTx is set, so a forwarder problem (1, 2, 4)
can delay an order but never lets one through unsplit.

Exit code (most urgent first): 3 SSO expired (operator: `aws sso login --profile nearbi`) > 5 refused by
config.yaml (kill switch, split mismatch, daily cap) > 1 error > 4 top up forwarder.nearbi.near > 2 a payment
or order needs a human > 0 ok / nothing to do. The log prints each step's own code.
A lock (~/.local/state/rs-agent/agent-tick.lock) makes an overlapping tick exit 0 at once. No launchd/cron is
installed by this repo; the scheduler (the main agent) runs e.g. `bin/agent-tick` every 2-5 minutes.
"""
import argparse
import fcntl
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "src"))

from rs_agent import forwarder as fw  # noqa: E402

PRIORITY = (3, 5, 1, 4, 2)  # most urgent first; 0 last


def combine(*codes: int) -> int:
    for c in PRIORITY:
        if c in codes:
            return c
    return 0 if all(c == 0 for c in codes) else 1


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--max-orders")
    ap.add_argument("--max-usd")
    ap.add_argument("--config")
    ap.add_argument("--skip-forwarder", action="store_true")
    a = ap.parse_args()

    lock = open(fw.state_dir() / "agent-tick.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fw.log("agent-tick: another tick is running; exiting")
        return 0
    common = (["--config", a.config] if a.config else []) + (["--dry-run"] if a.dry_run else [])
    codes = []
    if not a.skip_forwarder:
        fw.log(f"agent-tick: step 1/2 forwarder-runner --once{' --dry-run' if a.dry_run else ''}")
        rc1 = subprocess.call([sys.executable, str(ROOT / "bin/forwarder-runner"), "--once", *common])
        fw.log(f"agent-tick: forwarder-runner exit {rc1}")
        codes.append(rc1)
        if rc1 in (3, 5):
            fw.log(f"agent-tick: stopping before the order step (exit {rc1})")
            return rc1
    extra = (["--max-orders", a.max_orders] if a.max_orders else []) + (["--max-usd", a.max_usd] if a.max_usd else [])
    fw.log(f"agent-tick: step 2/2 agent-orders{' --dry-run' if a.dry_run else ''}")
    rc2 = subprocess.call([sys.executable, str(ROOT / "bin/agent-orders"), *common, *extra])
    fw.log(f"agent-tick: agent-orders exit {rc2}")
    codes.append(rc2)
    rc = combine(*codes)
    fw.log(f"agent-tick: done, exit {rc}")
    return rc


if __name__ == "__main__":
    sys.exit(main())
