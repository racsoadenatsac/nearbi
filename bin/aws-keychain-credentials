#!/usr/bin/env python3
"""aws-keychain-credentials: AWS `credential_process` helper. Reads an IAM access key from the macOS Keychain and
prints it in the credential_process JSON format (Version 1) on stdout, for the aws CLI only.

  ~/.aws/config:
    [profile nearbi-agent]
    credential_process = /Users/<you>/projects/research-shop/rs-agent/bin/aws-keychain-credentials nearbi-agent-aws
    region = us-east-1

The Keychain item (generic password, login keychain) has service <item> (default nearbi-agent-aws), account
nearbi-agent, and the value "<AccessKeyId>:<SecretAccessKey>". It is written once by the operator/agent with the
secret on stdin (README "Agent identity"). This script never logs, writes or echoes the secret: it goes from
`security` to the aws CLI through pipes only. On any failure it prints a one-line reason to stderr (no secret)
and exits 1; the aws CLI then fails and rs-agent stops with exit 3 ("AWS key invalid or missing").
"""
import json
import re
import subprocess
import sys

ITEM = sys.argv[1] if len(sys.argv) > 1 else "nearbi-agent-aws"
ACCOUNT = sys.argv[2] if len(sys.argv) > 2 else "nearbi-agent"


def main() -> int:
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", ITEM) or not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", ACCOUNT):
        print("aws-keychain-credentials: bad item/account name", file=sys.stderr)
        return 1
    p = subprocess.run(["/usr/bin/security", "find-generic-password", "-s", ITEM, "-a", ACCOUNT, "-w"],
                       capture_output=True, text=True)
    if p.returncode != 0:
        print(f"aws-keychain-credentials: Keychain item {ITEM} (account {ACCOUNT}) not readable "
              f"(security exit {p.returncode})", file=sys.stderr)
        return 1
    m = re.fullmatch(r"(AKIA[0-9A-Z]{16}):([A-Za-z0-9/+=]{40})", p.stdout.strip())
    if not m:
        print(f"aws-keychain-credentials: Keychain item {ITEM} is not '<AccessKeyId>:<SecretAccessKey>'", file=sys.stderr)
        return 1
    json.dump({"Version": 1, "AccessKeyId": m.group(1), "SecretAccessKey": m.group(2)}, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
