#!/usr/bin/env bash
# Pull every splitter event, rebuild ledger.jsonl (hash-chained), reconcile against the contract and
# render out/ledger/. Exits non-zero on any reconciliation mismatch; nothing is written in that case.
#   bin/build-ledger [--allow-seed-only] [--retries N]
set -euo pipefail
cd "$(dirname "$0")/.."
exec bin/py src/build_ledger.py "$@"
