#!/usr/bin/env bash
# Build, reconcile and publish the public ledger to https://nearbi.ai/ledger/.
#
#   AWS_PROFILE=nearbi bin/publish            # build + upload + invalidate /ledger/*
#   bin/publish --dry-run                     # build + show what would be uploaded
#
# Order of operations (nothing is uploaded unless every step passes):
#   1. AWS identity check; an expired SSO session exits 3 with "SSO expired" (never logs in)
#   2. download the live ledger.jsonl; it must stay a prefix of the new one (append-only)
#   3. bin/build-ledger (reconciliation must pass) and bin/verify-ledger on the output
#   4. aws s3 sync out/ledger/ -> s3://<bucket>/ledger/ (--delete, only under ledger/)
#   5. CloudFront invalidation of /ledger/*, then a 200 check on the live page
#
# Exit codes: 0 published, 1 build/reconcile/verify failed, 2 upload failed, 3 SSO expired.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
DRY=0; [ "${1:-}" = "--dry-run" ] && DRY=1
export AWS_PROFILE="${AWS_PROFILE:-nearbi}"
BUCKET="${NEARBI_SITE_BUCKET:-nearbi-site}"
DIST="${NEARBI_CF_DIST:-E2UZ7XHTGD4UEU}"
SITE="https://nearbi.ai/ledger/"

if ! aws sts get-caller-identity >/dev/null 2>&1; then
  echo "SSO expired (aws sts get-caller-identity failed for profile $AWS_PROFILE); not publishing" >&2
  exit 3
fi

mkdir -p out
PREV=data/ledger.jsonl
code=$(curl -s -o out/live-ledger.jsonl -w '%{http_code}' "${SITE}ledger.jsonl" || true)
if [ "$code" = 200 ] && [ -s out/live-ledger.jsonl ]; then
  live_n=$(wc -l < out/live-ledger.jsonl); local_n=$( [ -f "$PREV" ] && wc -l < "$PREV" || echo 0)
  # the longer of (live, local) is the reference; build checks it is a prefix of the rebuild
  if [ "$live_n" -ge "$local_n" ]; then PREV=out/live-ledger.jsonl; fi
  echo "append-only reference: $PREV ($(wc -l < "$PREV" | tr -d ' ') lines; live had $live_n)"
fi

bin/build-ledger --prev "$PREV" || { echo "build/reconcile failed; nothing published" >&2; exit 1; }
bin/verify-ledger out/ledger/ledger.jsonl || { echo "verify failed; nothing published" >&2; exit 1; }

if [ "$DRY" = 1 ]; then
  aws s3 sync out/ledger/ "s3://$BUCKET/ledger/" --delete --dryrun
  exit 0
fi

CC="public, max-age=60, must-revalidate"
up() { aws s3 cp "out/ledger/$1" "s3://$BUCKET/ledger/$1" --cache-control "$CC" --content-type "$2" --only-show-errors; }
{
  up ledger.jsonl "application/x-ndjson; charset=utf-8" &&
  up ledger.json "application/json; charset=utf-8" &&
  up verify_ledger.py "text/x-python; charset=utf-8" &&
  up index.html "text/html; charset=utf-8" &&
  aws s3 sync out/ledger/ "s3://$BUCKET/ledger/" --delete --size-only --only-show-errors
} || { echo "upload failed" >&2; exit 2; }
inv=$(aws cloudfront create-invalidation --distribution-id "$DIST" --paths "/ledger/*" "/ledger" \
  --query 'Invalidation.Id' --output text) || { echo "invalidation failed" >&2; exit 2; }
echo "invalidation $inv"
aws cloudfront wait invalidation-completed --distribution-id "$DIST" --id "$inv" || true
for p in "" ledger.jsonl ledger.json; do
  printf '%s %s\n' "$(curl -s -o /dev/null -w '%{http_code}' "$SITE$p")" "$SITE$p"
done
echo "published $(wc -l < out/ledger/ledger.jsonl | tr -d ' ') events, head $(tail -1 out/ledger/ledger.jsonl | python3 -c 'import sys,json;print(json.loads(sys.stdin.read() or "{}").get("line_hash","-"))')"
